{
  "name": "minsky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "ci": "node scripts/ci.mjs",
    "ci:worker": "node scripts/ci-worker.mjs",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:connector:runtime": "node scripts/connector-runtime-test.mjs",
    "test:connector:ui": "node src/server/adapters/cloudflare/tooling/test-ui.mjs",
    "test:connector:ui:local": "node scripts/connector-local-ui-test.mjs",
    "test:connector:workflow:hosted": "node src/server/adapters/cloudflare/tooling/test-store.mjs workflow",
    "test:connector:accounts:hosted": "node src/server/adapters/cloudflare/tooling/test-store.mjs accounts",
    "cloudflare:install": "node src/server/adapters/cloudflare/tooling/install.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/landing.spec.ts tests/journey.spec.ts",
    "test:providers": "node scripts/provider-test.mjs",
    "test:providers:list": "playwright test --config playwright.providers.config.ts --list",
    "deploy": "node scripts/deploy-workers.mjs --build --site=app && node scripts/deploy-workers.mjs --site=app",
    "docs:dev": "npm --prefix site run dev --",
    "docs:build": "npm --prefix site run build",
    "docs:preview": "npm --prefix site run preview --",
    "docs:test": "playwright test --config playwright.docs.config.ts",
    "docs:deploy": "npm run docs:build && wrangler deploy --config wrangler.docs.jsonc",
    "cloud:login": "supabase login",
    "cloud:link": "supabase link --project-ref ovymmobupzowotvrywek",
    "cloud:plan": "supabase db push --linked --dry-run",
    "cloud:migrate": "supabase db push --linked",
    "cloud:functions": "supabase functions deploy admin --project-ref ovymmobupzowotvrywek --use-api && supabase functions deploy attachments --project-ref ovymmobupzowotvrywek --use-api",
    "cloud:hosting-login": "wrangler login",
    "cloud:bootstrap": "node scripts/bootstrap.mjs",
    "check:functions": "deno check --node-modules-dir=none supabase/functions/admin/index.ts supabase/functions/attachments/index.ts supabase/functions/announcement-images/index.ts && deno check --node-modules-dir=none --config supabase/functions/workflow/deno.json supabase/functions/workflow/index.ts",
    "test:functions": "deno test --node-modules-dir=none supabase/functions/attachments/handler.test.ts supabase/functions/announcement-images/handler.test.ts",
    "test:cloud": "node scripts/cloud-test.mjs",
    "test:hosted": "node scripts/cloud-smoke.mjs",
    "cloud:recover-admin": "node scripts/recover-admin.mjs",
    "cloudflare:recover-admin": "node scripts/recover-cloudflare-admin.mjs",
    "test:workflow:hosted": "node scripts/workflow-proof.mjs",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "test:auth:hosted": "node scripts/auth-test.mjs",
    "test:auth:hash": "node scripts/auth-hash-benchmark.mjs",
    "test:auth:http": "node scripts/auth-http-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "better-auth": "1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.4",
    "wrangler": "4.151.2"
  }
}
