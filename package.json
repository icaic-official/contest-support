{
  "name": "minsky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "docs:dev": "npm --prefix site run dev --",
    "docs:build": "npm --prefix site run build",
    "docs:preview": "npm --prefix site run preview --",
    "docs:test": "playwright test --config playwright.docs.config.ts",
    "docs:deploy": "npm run docs:build && wrangler deploy --config wrangler.docs.jsonc",
    "cloud:login": "supabase login",
    "cloud:link": "supabase link --project-ref ovymmobupzowotvrywek",
    "cloud:plan": "supabase db push --linked --dry-run",
    "cloud:migrate": "supabase db push --linked",
    "cloud:functions": "supabase functions deploy admin --project-ref ovymmobupzowotvrywek --use-api && supabase functions deploy attachments --project-ref ovymmobupzowotvrywek --use-api",
    "cloud:hosting-login": "wrangler login",
    "cloud:bootstrap": "node scripts/bootstrap.mjs",
    "check:functions": "deno check --node-modules-dir=none supabase/functions/admin/index.ts supabase/functions/attachments/index.ts",
    "test:functions": "deno test --node-modules-dir=none supabase/functions/attachments/handler.test.ts",
    "test:cloud": "node scripts/cloud-test.mjs",
    "test:hosted": "node scripts/cloud-smoke.mjs",
    "cloud:recover-admin": "node scripts/recover-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "deno": "2.9.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supabase": "2.121.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.4",
    "wrangler": "4.149.0"
  }
}
