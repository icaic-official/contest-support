{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vitest.d1.config.ts",
    "vitest.auth.config.ts",
    "vitest.auth-http.config.ts",
    "playwright.auth.config.ts",
    "playwright.config.ts",
    "playwright.cloud.config.ts",
    "playwright.providers.config.ts",
    "playwright.docs.config.ts",
    "site/tests"
  ]
}
